# Allow bubblewrap to create unprivileged user namespaces on Ubuntu 24.04.
#
# Ubuntu restricts unprivileged user namespaces with AppArmor. bubblewrap is a
# sandboxing tool; without this profile, bwrap fails with
# "setting up uid map: Permission denied" even for ordinary desktop users.
# The profile is intentionally unconfined: bubblewrap performs the actual
# isolation with namespaces and seccomp. Site-specific rules can be added in
# /etc/apparmor.d/local/anvil-bwrap.
abi <abi/4.0>,
include <tunables/global>

profile anvil-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/anvil-bwrap>
}
